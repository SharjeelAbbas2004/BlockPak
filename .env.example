# Database (PostgreSQL) — provided by the hosting environment or local Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/web3pakistan"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Public site URL (used for sitemap, robots, canonical links, share URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial admin account (used by prisma seed)
ADMIN_EMAIL="admin@web3pakistan.pk"
ADMIN_PASSWORD="change-me-immediately"

# AI API key (optional — used for AI-assisted editorial features)
AI_API_KEY=""
